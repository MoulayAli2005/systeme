generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  country   String   @default("MA")
  timezone  String   @default("Africa/Casablanca")
  currency  String   @default("MAD")
  locale    String   @default("fr")
  plan      String   @default("STARTER")
  status    String   @default("active")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  memberships     Membership[]
  roles           Role[]
  stores          Store[]
  warehouses      Warehouse[]
  products        Product[]
  customers       Customer[]
  orders          Order[]
  teams           Team[]
  agents          AgentProfile[]
  conversations   Conversation[]
  shipments       Shipment[]
  returns         ReturnCase[]
  campaigns       Campaign[]
  automations     Automation[]
  integrations    Integration[]
  webhooks        WebhookEndpoint[]
  apiKeys         ApiKey[]
  notifications   Notification[]
  tasks           Task[]
  auditLogs       AuditLog[]
  statusDefs      StatusDefinition[]
  carriers        Carrier[]
  templates       MessageTemplate[]
  suppliers       Supplier[]
  inventoryItems  InventoryItem[]
  ads             Ad[]
  adSpend         AdSpend[]
  usageRecords    UsageRecord[]
  subscription    Subscription?
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String
  passwordHash     String?
  emailVerifiedAt  DateTime?
  totpSecretEnc    String?
  totpEnabled      Boolean   @default(false)
  isPlatformAdmin  Boolean   @default(false)
  locale           String    @default("en")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  memberships   Membership[]
  sessions      Session[]
  loginEvents   LoginEvent[]
  assignedOrders Order[]     @relation("OrderAgent")
  calls         Call[]
  auditLogs     AuditLog[]
  tasksAssigned Task[]       @relation("TaskAssignee")
  tasksCreated  Task[]       @relation("TaskCreator")
  agentProfile  AgentProfile?
}

model Membership {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         String   @default("active")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id             String   @id @default(uuid())
  organizationId String?
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]

  @@unique([organizationId, key])
}

model Permission {
  id     String @id @default(uuid())
  key    String @unique
  module String
  name   String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  tokenHash      String   @unique
  ip             String?
  userAgent      String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  rotatedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StatusDefinition {
  id             String  @id @default(uuid())
  organizationId String
  key            String
  label          String
  color          String  @default("zinc")
  sortOrder      Int     @default(0)
  isTerminal     Boolean @default(false)
  category       String  @default("open")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model Store {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  domain         String?
  platform       String    @default("manual")
  currency       String    @default("MAD")
  country        String    @default("MA")
  warehouseId    String?
  carrierId      String?
  credentialsEnc String?
  externalId     String?
  status         String    @default("connected")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
  products     Product[]
  orders       Order[]

  @@index([organizationId])
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  city           String
  country        String   @default("MA")
  address        String?
  isDefault      Boolean  @default(false)
  routingRules   Json     @default("[]")
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stores       Store[]
  inventory    InventoryItem[]
  orders       Order[]
  transfersOut StockTransfer[] @relation("TransferFrom")
  transfersIn  StockTransfer[] @relation("TransferTo")

  @@index([organizationId])
}

model Supplier {
  id             String @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
}

model Product {
  id             String    @id @default(uuid())
  organizationId String
  storeId        String?
  supplierId     String?
  name           String
  sku            String
  barcode        String?
  description    String?
  category       String?
  tags           String[]  @default([])
  cost           Decimal   @default(0) @db.Decimal(12, 2)
  price          Decimal   @db.Decimal(12, 2)
  compareAt      Decimal?  @db.Decimal(12, 2)
  weightGrams    Int?
  hue            Int       @default(160)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?           @relation(fields: [storeId], references: [id])
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  variants     ProductVariant[]

  @@unique([organizationId, sku])
  @@index([organizationId, category])
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  name       String
  sku        String
  options    Json    @default("{}")
  price      Decimal @db.Decimal(12, 2)
  cost       Decimal @default(0) @db.Decimal(12, 2)
  barcode    String?

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory InventoryItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model InventoryItem {
  id             String @id @default(uuid())
  organizationId String
  variantId      String
  warehouseId    String
  onHand         Int    @default(0)
  reserved       Int    @default(0)
  incoming       Int    @default(0)
  damaged        Int    @default(0)
  returned       Int    @default(0)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]

  @@unique([variantId, warehouseId])
}

model InventoryMovement {
  id         String   @id @default(uuid())
  itemId     String
  type       String
  quantity   Int
  reason     String?
  createdAt  DateTime @default(now())
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model StockTransfer {
  id             String   @id @default(uuid())
  fromId         String
  toId           String
  status         String   @default("draft")
  notes          String?
  createdAt      DateTime @default(now())
  from           Warehouse @relation("TransferFrom", fields: [fromId], references: [id])
  to             Warehouse @relation("TransferTo", fields: [toId], references: [id])
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  phone          String
  phone2         String?
  email          String?
  address        String?
  city           String
  region         String?
  country        String   @default("MA")
  tags           String[] @default([])
  notes          String?
  riskScore      Int      @default(20)
  riskLabel      String   @default("normal")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations Conversation[]

  @@index([organizationId, phone])
  @@index([organizationId, city])
  @@index([organizationId, name])
}

model Team {
  id             String @id @default(uuid())
  organizationId String
  name           String
  kind           String @default("confirmation")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents       AgentProfile[]
}

model AgentProfile {
  id             String  @id @default(uuid())
  organizationId String
  userId         String  @unique
  teamId         String?
  state          String  @default("offline")
  confirmedToday Int     @default(0)
  avgConfirmMin  Int     @default(0)
  hue            Int     @default(160)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id])
  calls        Call[]
}

model Order {
  id               String   @id @default(uuid())
  organizationId   String
  storeId          String?
  warehouseId      String?
  customerId       String
  agentId          String?
  number           String
  status           String   @default("NEW")
  paymentMethod    String   @default("cod")
  source           String   @default("manual")
  campaign         String?
  adId             String?
  landingPage      String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  subtotal         Decimal  @db.Decimal(12, 2)
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  shippingFee      Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  codAmount        Decimal  @default(0) @db.Decimal(12, 2)
  currency         String   @default("MAD")
  notes            String?
  tags             String[] @default([])
  duplicateOfId    String?
  riskScore        Int      @default(0)
  callAttempts     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store         Store?        @relation(fields: [storeId], references: [id])
  warehouse     Warehouse?    @relation(fields: [warehouseId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  agent         User?         @relation("OrderAgent", fields: [agentId], references: [id])
  items         OrderItem[]
  events        OrderEvent[]
  calls         Call[]
  shipments     Shipment[]
  returns       ReturnCase[]
  conversations Conversation[]
  tasks         Task[]

  @@unique([organizationId, number])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, agentId])
  @@index([organizationId, storeId])
  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  variantId String?
  name      String
  variant   String?
  sku       String?
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  cost      Decimal @default(0) @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  title     String
  detail    String?
  tone      String   @default("default")
  actorId   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Call {
  id          String    @id @default(uuid())
  orderId     String?
  agentId     String
  profileId   String?
  provider    String    @default("demo")
  status      String    @default("queued")
  durationSec Int?
  notes       String?
  recordingUrl String?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  order   Order?        @relation(fields: [orderId], references: [id])
  agent   User          @relation(fields: [agentId], references: [id])
  profile AgentProfile? @relation(fields: [profileId], references: [id])

  @@index([agentId, createdAt])
}

model Conversation {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String
  orderId        String?
  channel        String
  assignedToId   String?
  unread         Int      @default(0)
  lastMessage    String?
  lastAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
  messages     Message[]

  @@index([organizationId, lastAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  from           String
  text           String
  providerId     String?
  status         String   @default("sent")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model MessageTemplate {
  id             String @id @default(uuid())
  organizationId String
  channel        String
  name           String
  body           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Carrier {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  adapter        String  @default("demo")
  connected      Boolean @default(false)
  credentialsEnc String?
  pickupWindow   String?
  deliveredRate  Int     @default(85)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipments    Shipment[]
}

model Shipment {
  id             String   @id @default(uuid())
  organizationId String
  orderId        String
  carrierId      String?
  awb            String?
  status         String   @default("created")
  labelUrl       String?
  trackingUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier      Carrier?     @relation(fields: [carrierId], references: [id])

  @@index([organizationId, createdAt])
  @@index([awb])
}

model ReturnCase {
  id             String   @id @default(uuid())
  organizationId String
  orderId        String
  status         String   @default("RETURN_REQUESTED")
  reason         String?
  condition      String?
  refundAmount   Decimal? @db.Decimal(12, 2)
  shippingCost   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model Campaign {
  id             String   @id @default(uuid())
  organizationId String
  platform       String
  name           String
  externalId     String?
  status         String   @default("active")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ads          Ad[]
}

model Ad {
  id             String @id @default(uuid())
  organizationId String
  campaignId     String
  name           String
  externalId     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spend        AdSpend[]
}

model AdSpend {
  id             String   @id @default(uuid())
  organizationId String
  adId           String
  date           DateTime @db.Date
  spend          Decimal  @db.Decimal(12, 2)
  impressions    Int      @default(0)
  clicks         Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ad           Ad           @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
}

model Automation {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  enabled        Boolean @default(true)
  trigger        String
  conditions     Json    @default("{}")
  actions        Json    @default("[]")
  runsToday      Int     @default(0)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]
}

model AutomationRun {
  id            String   @id @default(uuid())
  automationId  String
  orderId       String?
  status        String
  log           String?
  createdAt     DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
}

model Integration {
  id             String   @id @default(uuid())
  organizationId String
  kind           String
  provider       String
  name           String
  connected      Boolean  @default(false)
  credentialsEnc String?
  config         Json     @default("{}")
  lastSyncAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
}

model WebhookEndpoint {
  id             String   @id @default(uuid())
  organizationId String
  url            String
  secret         String
  events         String[]
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  endpointId String
  event      String
  payload    Json
  status     String   @default("pending")
  attempts   Int      @default(0)
  response   String?
  createdAt  DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  prefix         String
  hash           String    @unique
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  title          String
  body           String
  kind           String   @default("info")
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Task {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  description    String?
  assigneeId     String?
  creatorId      String?
  orderId        String?
  priority       String    @default("medium")
  status         String    @default("open")
  dueAt          DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator      User?        @relation("TaskCreator", fields: [creatorId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

model Subscription {
  id                   String    @id @default(uuid())
  organizationId       String    @unique
  plan                 String    @default("STARTER")
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  periodEnd            DateTime?
  createdAt            DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id             String   @id @default(uuid())
  organizationId String
  metric         String
  quantity       Int
  period         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, period, metric])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
